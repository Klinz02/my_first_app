{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build Debug APK",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "\"${env:USERPROFILE}\\.android\\flutter\\bin\\flutter.bat\" build apk --debug --no-pub --verbose > \"${workspaceFolder}\\build\\android-build.log\" 2>&1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}